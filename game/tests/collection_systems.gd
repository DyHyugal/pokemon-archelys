extends SceneTree
const Campaign=preload("res://scripts/domain/campaign.gd")
const Adventure=preload("res://scripts/domain/solo_adventure.gd")
const Records=preload("res://scripts/domain/journey_records.gd")
const Cinema=preload("res://scripts/domain/cinematic.gd")
const Battle=preload("res://scripts/domain/pokemon_battle.gd")
const Double=preload("res://scripts/domain/double_battle.gd")
const Mon=preload("res://scripts/domain/pokemon.gd")
const Slots=preload("res://scripts/services/save_slots.gd")
const Store=preload("res://scripts/services/save_store.gd")
var checks:=0
var failures:=0
func check(ok: bool,label: String) -> void:
 checks+=1
 if not ok:failures+=1;push_error(label)
func _initialize() -> void:
 var a:=Adventure.new();a.initialize()
 check(a.records.caught.size()==3 and a.records.seen.size()==3,"Initial owned species recorded")
 a.wild(8,"rattata")
 check(not a.records.seen.has("rattata"),"Generating an unseen encounter does not leak it")
 var b:=Battle.new();b.begin(a,[Mon.make("rattata",8,900000),Mon.make("pikachu",8,900001)],"trainer-1")
 check(a.records.seen.has("rattata") and not a.records.caught.has("rattata") and not a.records.seen.has("pikachu"),"Only active enemy is seen, never entire hidden bench")
 b.switch_enemy(1);check(a.records.seen.has("pikachu"),"Enemy switch adds actually sent species");b.finish("escaped")
 var d:=Double.new();d.begin(a,[Mon.make("vulpix",10,900000),Mon.make("ninetales",36,900001)])
 check(a.records.seen.has("vulpix") and a.records.seen.has("ninetales"),"Both visible doubles actors recorded");d.finish("escaped")
 a.add(Mon.make("pikachu",8,a.next_uid));a.use("thunder-stone",int(a.team[-1].uid))
 check(a.records.caught.has("pikachu") and a.records.caught.has("raichu"),"Item evolution retains old species and records new one")
 a.raise_cap(18);a.gain_experience(1,100000)
 for index: int in range(a.pending.size()-1,-1,-1):
  if a.pending[index].kind=="evolution":a.resolve_choice(index,0)
 check(a.records.caught.has("ivysaur") and a.records.caught.has("bulbasaur"),"Level evolution history preserved")
 check(Records.habitats("gyarados")==["cove"] and Records.habitats("raichu").is_empty() and Records.habitats("venusaur")==["village"],"Habitats share legal encounter stages and item evolutions do not spawn")
 var bad:=a.records.snapshot();bad.seen.erase("bulbasaur")
 check(not Records.validate(bad),"Obtained must be seen")
 bad=a.records.snapshot();bad.scenes["unknown"]=true;check(not Records.validate(bad),"Unknown cinematic identifiers rejected")
 var records:=Records.new();var movie:=Cinema.new()
 check(not movie.begin("lab-tour",records,true),"Replay locked before full first completion")
 check(movie.begin("lab-tour",records) and movie.current().fr.contains("laboratoire"),"Main timeline begins with data-driven localized shot")
 check(not movie.skip() and movie.active and not records.scenes.has("lab-tour"),"Main scene cannot skip or unlock early")
 check(not movie.begin("lab-note",records),"Overlapping scene rejected")
 for i: int in range(4):movie.advance()
 check(not movie.active and records.scenes.has("lab-tour"),"Full main timeline unlocks replay")
 check(not movie.begin("lab-tour",records) and movie.begin("lab-tour",records,true),"Already unlocked main uses replay only")
 for i: int in range(4):movie.advance()
 check(records.scenes.size()==1,"Replay cannot create additional completion rewards")
 check(movie.begin("lab-note",records) and movie.skip() and not movie.begin("lab-note",records,true),"Secondary scene skippable and never replayable")
 var prefix: String="user://tests_collection_slots"
 var dir:=DirAccess.open("user://")
 for file: String in dir.get_files():
  if file.begins_with("tests_collection_slots"):dir.remove(file)
 var slots:=Slots.new(prefix);var c:=Campaign.new();c.add_player(1,"Test");c.adventure.initialize()
 check(slots.active==1 and slots.autosave and slots.describe(1).status=="empty","Fresh solo slots initialized")
 var old:=c.snapshot();old.schema=4;old.adventure.erase("records")
 check(Store.write_snapshot(slots.path(1),old)==OK,"Legacy slot1 same path as old manual save")
 var bytes:=FileAccess.get_file_as_string(slots.path(1));c.restore(old)
 check(c.adventure.records.caught.size()==3 and c.adventure.records.scenes.is_empty(),"Migration rebuilds owned species without inventing past observations or movies")
 check(slots.write(c.snapshot())==OK and FileAccess.get_file_as_string(slots.path(1)+".v4.backup")==bytes,"Schema5 migration preserves original schema4 bytes")
 c.adventure.money=1234;slots.write(c.snapshot(),true)
 check(slots.read(1).adventure.money==3000 and slots.read(1,true).adventure.money==1234,"Autosave never overwrites manual slot")
 slots.select(2);c.adventure.money=2000;slots.write(c.snapshot())
 check(slots.read(1).adventure.money==3000 and slots.read(2).adventure.money==2000,"Different manual slots remain independent")
 var fresh:=Slots.new(prefix);check(fresh.active==2 and fresh.read(3).is_empty(),"Active slot persisted and missing slot returns no data")
 fresh.set_autosave(false);check(not Slots.new(prefix).autosave,"Autosave preference survives new service instance")
 check(slots.select(0)==ERR_INVALID_PARAMETER and slots.active==2 and slots.path(4).is_empty(),"Invalid slot cannot change current selection or target arbitrary path")
 c.adventure.money=2100;slots.write(c.snapshot());check(slots.read(2,false,true).adventure.money==2000,"Manual rolling backup is separately restorable")
 var corrupt:=FileAccess.open(slots.path(2),FileAccess.WRITE);corrupt.store_string("broken original");corrupt.close()
 check(slots.describe(2).status=="invalid" and slots.read(2).is_empty(),"Corrupt slot reported, never silently replaced with another save")
 slots.write(c.snapshot());var preserved:=false
 for file: String in dir.get_files():
  if file.begins_with("tests_collection_slots.slot2.json.invalid-") and FileAccess.get_file_as_string("user://"+file)=="broken original":preserved=true
 check(preserved,"Explicit overwrite preserves corrupt original bytes")
 var invalid:=c.snapshot();invalid.adventure.records.caught["missing-species"]=true
 check(slots.write(invalid)==ERR_INVALID_DATA and slots.read(2).adventure.money==2100,"Invalid discovery history cannot replace valid live file")
 c.configure(2);check(slots.write(c.snapshot())==ERR_INVALID_DATA,"Solo slots reject network campaigns")
 print("COLLECTION SYSTEMS: %d checks, %d failures" % [checks,failures]);quit(1 if failures else 0)
